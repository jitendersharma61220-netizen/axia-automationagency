# Copy to .env and fill in per client. Never commit the real .env.
AXIA_BUSINESS_NAME="Smile Dental Clinic"
AXIA_OWNER_EMAIL=owner@example.com
AXIA_DB_PATH=leads.db
AXIA_FOLLOWUP_DAYS=0,2,5

# Leave AXIA_DRY_RUN=1 to print messages instead of sending them.
AXIA_DRY_RUN=1
AXIA_SMTP_HOST=smtp.gmail.com
AXIA_SMTP_PORT=587
AXIA_SMTP_USER=
AXIA_SMTP_PASSWORD=
AXIA_FROM_EMAIL=

# --- AI agents ---------------------------------------------------------
# Claude API key from https://console.anthropic.com (pip install -r requirements.txt)
ANTHROPIC_API_KEY=
# WhatsApp Cloud API (Meta for Developers > WhatsApp > API setup)
AXIA_WA_PHONE_ID=
AXIA_WA_TOKEN=
AXIA_WA_VERIFY_TOKEN=choose-any-secret
# Per-client playbook for the sales agent
AXIA_SALES_PLAYBOOK=examples/sales_playbook.json
AXIA_SALES_DB=sales.db
AXIA_MARKETING_BRAND=examples/marketing_brand.json
AXIA_OPS_COMPANY=examples/ops_company.json
AXIA_OPS_POS=examples/purchase_orders.csv
