# Copy to .env and fill in per client. Never commit the real .env.
AXIA_BUSINESS_NAME="Smile Dental Clinic"
AXIA_OWNER_EMAIL=owner@example.com
AXIA_DB_PATH=leads.db
AXIA_FOLLOWUP_DAYS=0,2,5

# Leave AXIA_DRY_RUN=1 to print messages instead of sending them.
AXIA_DRY_RUN=1
AXIA_SMTP_HOST=smtp.gmail.com
AXIA_SMTP_PORT=587
AXIA_SMTP_USER=
AXIA_SMTP_PASSWORD=
AXIA_FROM_EMAIL=
